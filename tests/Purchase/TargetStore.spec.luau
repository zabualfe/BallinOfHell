describe("PurchaseService.TargetStore", function()
	local TargetStore = load("ServerScriptService/Script/PurchaseService/TargetStore")
	local player = { Name = "A" }
	local other = { Name = "B" }

	it("returns the stored target only for its product", function()
		local store = TargetStore.new()
		store:Set(player, "BallUnlockRare", "ember")
		expect(store:Get(player, "BallUnlockRare")):equal("ember")
		expect(store:Get(player, "BallUnlockEpic")):equal(nil)
		expect(store:Get(other, "BallUnlockRare")):equal(nil)
	end)

	it("a newer prompt replaces the older one", function()
		local store = TargetStore.new()
		store:Set(player, "BallUnlockRare", "ember")
		store:Set(player, "BallUnlockEpic", "inferno")
		expect(store:Get(player, "BallUnlockRare")):equal(nil)
		expect(store:Get(player, "BallUnlockEpic")):equal("inferno")
	end)

	it("clears after a grant, by key or fully", function()
		local store = TargetStore.new()
		store:Set(player, "A", 1)
		expect(store:Clear(player, "B")):falsy()
		expect(store:Get(player, "A")):equal(1)
		expect(store:Clear(player, "A")):truthy()
		expect(store:Get(player, "A")):equal(nil)
		store:Set(player, "A", 1)
		expect(store:Clear(player)):truthy()
		expect(store:Get(player, "A")):equal(nil)
	end)

	it("abandon clears an unbought prompt only", function()
		local store = TargetStore.new()
		store:Set(player, "A", 1)
		expect(store:Abandon(player, "A", true)):falsy()
		expect(store:Get(player, "A")):equal(1)
		expect(store:Abandon(player, "B", false)):falsy()
		expect(store:Abandon(player, "A", false)):truthy()
		expect(store:Get(player, "A")):equal(nil)
	end)
end)
