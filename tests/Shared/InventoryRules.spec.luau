describe("InventoryRules", function()
	local InventoryRules = load("ReplicatedStorage/Shared/InventoryRules")

	it("whitelists exactly the three Starter balls", function()
		expect(InventoryRules.StarterIds()):equal({ "sprinter", "grip", "bouncer" })
		expect(InventoryRules.IsStarter("grip")):truthy()
		expect(InventoryRules.IsStarter("cinder")):falsy()
		expect(InventoryRules.IsStarter("nope")):falsy()
		expect(InventoryRules.IsStarter(5)):falsy()
	end)

	it("picking a non-starter id does nothing", function()
		expect(InventoryRules.CanPickStarter("cinder", false)):falsy()
		expect(InventoryRules.CanPickStarter("crownofhell", false)):falsy()
		expect(InventoryRules.CanPickStarter(nil, false)):falsy()
	end)

	it("lets a starter be picked once", function()
		expect(InventoryRules.CanPickStarter("sprinter", false)):truthy()
		expect(InventoryRules.CanPickStarter("sprinter", true)):falsy()
	end)

	it("grants a fresh ball from the right source", function()
		local ok, reason = InventoryRules.DecideGrant("cinder", "Coins", {})
		expect(ok):truthy()
		expect(reason):equal(nil)
		expect(InventoryRules.DecideGrant("cinder", "Robux", {})):truthy()
		expect(InventoryRules.DecideGrant("sprinter", "Starter", {})):truthy()
		expect(InventoryRules.DecideGrant("smokewraith", "Wheel", {})):truthy()
	end)

	it("rejects unknown and owned balls", function()
		local _, unknown = InventoryRules.DecideGrant("nope", "Coins", {})
		expect(unknown):equal("Unknown")
		local _, owned = InventoryRules.DecideGrant("cinder", "Coins", { cinder = { at = 1 } })
		expect(owned):equal("Owned")
	end)

	it("rejects exclusives from the wrong source", function()
		for _, source in { "Coins", "Robux", "Daily", "Starter", "" } do
			local ok, reason = InventoryRules.DecideGrant("smokewraith", source, {})
			expect(ok):falsy()
			expect(reason):equal("WrongSource")
		end
		expect(InventoryRules.IsSourceAllowed("crownofhell", "Coins")):falsy()
		expect(InventoryRules.IsSourceAllowed("crownofhell", "RobuxLimited")):truthy()
		expect(InventoryRules.IsSourceAllowed("cinder", "Wheel")):falsy()
		expect(InventoryRules.IsSourceAllowed("cinder", nil)):falsy()
	end)

	it("lets Admin grant any known ball", function()
		expect(InventoryRules.IsSourceAllowed("crownofhell", "Admin")):truthy()
		expect(InventoryRules.IsSourceAllowed("nope", "Admin")):falsy()
	end)
end)
