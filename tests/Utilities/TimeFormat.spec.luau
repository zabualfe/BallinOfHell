describe("TimeFormat", function()
	local TimeFormat = load("ReplicatedStorage/Utilities/TimeFormat")

	it("formats clock times", function()
		expect(TimeFormat.Clock(0)):equal("0:00")
		expect(TimeFormat.Clock(75)):equal("1:15")
		expect(TimeFormat.Clock(75, true)):equal("01:15")
		expect(TimeFormat.Clock(3600)):equal("1:00:00")
		expect(TimeFormat.Clock(3725.9)):equal("1:02:05")
		expect(TimeFormat.Clock(-5)):equal("0:00")
	end)

	it("formats short durations", function()
		expect(TimeFormat.Short(45)):equal("45s")
		expect(TimeFormat.Short(190)):equal("3m 10s")
		expect(TimeFormat.Short(7500)):equal("2h 5m")
		expect(TimeFormat.Short(97200)):equal("1d 3h")
	end)
end)
