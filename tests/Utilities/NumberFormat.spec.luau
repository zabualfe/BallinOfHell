describe("NumberFormat", function()
	local NumberFormat = load("ReplicatedStorage/Utilities/NumberFormat")

	it("adds commas", function()
		expect(NumberFormat.Commas(0)):equal("0")
		expect(NumberFormat.Commas(999)):equal("999")
		expect(NumberFormat.Commas(1000)):equal("1,000")
		expect(NumberFormat.Commas(1234567)):equal("1,234,567")
		expect(NumberFormat.Commas(-1234)):equal("-1,234")
	end)

	it("abbreviates", function()
		expect(NumberFormat.Abbreviate(0)):equal("0")
		expect(NumberFormat.Abbreviate(999)):equal("999")
		expect(NumberFormat.Abbreviate(1000)):equal("1K")
		expect(NumberFormat.Abbreviate(1234)):equal("1.2K")
		expect(NumberFormat.Abbreviate(999999)):equal("999.9K")
		expect(NumberFormat.Abbreviate(3400000)):equal("3.4M")
		expect(NumberFormat.Abbreviate(2500000000)):equal("2.5B")
		expect(NumberFormat.Abbreviate(-1500)):equal("-1.5K")
	end)
end)
