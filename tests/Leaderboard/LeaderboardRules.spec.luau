describe("LeaderboardRules", function()
	local Rules = load("ServerScriptService/Script/LeaderboardService/LeaderboardRules")

	describe("ApplyFinish", function()
		it("counts place 1 as a win and sets the first best time", function()
			local wins, best, winsChanged, bestChanged = Rules.ApplyFinish(0, 0, 1, 90.5)
			expect(wins):equal(1)
			expect(best):equal(90.5)
			expect(winsChanged):truthy()
			expect(bestChanged):truthy()
		end)
		it("does not count other places as wins but still records a best time", function()
			local wins, best, winsChanged = Rules.ApplyFinish(3, 0, 2, 100)
			expect(wins):equal(3)
			expect(best):equal(100)
			expect(winsChanged):falsy()
		end)
		it("keeps the best time when slower or equal", function()
			local _, best, _, bestChanged = Rules.ApplyFinish(1, 80, 1, 95)
			expect(best):equal(80)
			expect(bestChanged):falsy()
			local _, same = Rules.ApplyFinish(1, 80, 1, 80)
			expect(same):equal(80)
		end)
		it("lowers the best time when faster", function()
			local _, best = Rules.ApplyFinish(1, 80, 3, 79.9)
			expect(best):equal(79.9)
		end)
		it("counts a win but sets no record when a paid skip was used", function()
			local wins, best, winsChanged, bestChanged = Rules.ApplyFinish(2, 80, 1, 50, true)
			expect(wins):equal(3)
			expect(winsChanged):truthy()
			expect(best):equal(80)
			expect(bestChanged):falsy()
			expect(select(2, Rules.ApplyFinish(0, 0, 1, 50, true))):equal(0)
		end)
		it("detects a paid skip from the Skipped map", function()
			expect(Rules.UsedSkip({})):falsy()
			expect(Rules.UsedSkip(nil)):falsy()
			expect(Rules.UsedSkip({ [3] = true })):truthy()
		end)
		it("ignores invalid times", function()
			expect(select(2, Rules.ApplyFinish(0, 0, 1, 0))):equal(0)
			expect(select(2, Rules.ApplyFinish(0, 0, 1, -5))):equal(0)
			expect(select(2, Rules.ApplyFinish(0, 0, 1, 0 / 0))):equal(0)
			expect(select(2, Rules.ApplyFinish(0, 0, 1, math.huge))):equal(0)
		end)
	end)

	describe("milliseconds", function()
		it("rounds to integer milliseconds", function()
			expect(Rules.ToMillis(90.5)):equal(90500)
			expect(Rules.ToMillis(12.3456)):equal(12346)
		end)
		it("never encodes a valid time as 0", function()
			expect(Rules.ToMillis(0.0001)):equal(1)
		end)
		it("round-trips", function()
			expect(Rules.FromMillis(Rules.ToMillis(75.25))):near(75.25, 1e-9)
		end)
	end)

	describe("batching", function()
		local pending = {
			[2] = { Wins = 5 },
			[1] = { Wins = 3, Fastest = 61000 },
		}
		it("orders jobs by user, fastest first, one per field", function()
			local jobs = Rules.BuildJobs(pending)
			expect(#jobs):equal(3)
			expect(jobs[1]):equal({ Store = "Fastest", UserId = 1, Value = 61000 })
			expect(jobs[2]):equal({ Store = "Wins", UserId = 1, Value = 3 })
			expect(jobs[3]):equal({ Store = "Wins", UserId = 2, Value = 5 })
		end)
		it("takes only what the budget allows after the reserve", function()
			local jobs = Rules.BuildJobs(pending)
			local taken, remaining = Rules.TakeJobs(jobs, 3, 2)
			expect(#taken):equal(1)
			expect(#remaining):equal(2)
		end)
		it("takes nothing with no budget", function()
			local taken, remaining = Rules.TakeJobs(Rules.BuildJobs(pending), 1, 2)
			expect(#taken):equal(0)
			expect(#remaining):equal(3)
		end)
		it("takes everything with plenty of budget", function()
			local taken, remaining = Rules.TakeJobs(Rules.BuildJobs(pending), 100, 2)
			expect(#taken):equal(3)
			expect(#remaining):equal(0)
		end)
	end)

	describe("rows", function()
		it("builds rows, decodes values and drops bad keys", function()
			local rows = Rules.BuildRows({
				{ key = "10", value = 61000 },
				{ key = "bad", value = 5 },
				{ key = "20", value = 70500 },
			}, { [10] = "Ann" }, Rules.FromMillis)
			expect(#rows):equal(2)
			expect(rows[1]):equal({ UserId = 10, Name = "Ann", Value = 61 })
			expect(rows[2].Name):equal("Unknown")
			expect(rows[2].Value):near(70.5, 1e-9)
		end)
		it("compares rows", function()
			local a = { { UserId = 1, Name = "A", Value = 2 } }
			expect(Rules.SameRows(a, { { UserId = 1, Name = "A", Value = 2 } })):truthy()
			expect(Rules.SameRows(a, { { UserId = 1, Name = "A", Value = 3 } })):falsy()
			expect(Rules.SameRows(a, {})):falsy()
		end)
	end)
end)
