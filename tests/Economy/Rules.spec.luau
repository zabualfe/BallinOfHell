describe("EconomyService.Rules", function()
	local Rules = load("ServerScriptService/Script/EconomyService/Rules")
	local EconomyTable = load("ReplicatedStorage/Tables/EconomyTable")
	local RarityTable = load("ReplicatedStorage/Tables/RarityTable")
	local BallTable = load("ReplicatedStorage/Tables/BallTable")
	local CourseTable = load("ReplicatedStorage/Tables/CourseTable")
	local AnalyticsTable = load("ReplicatedStorage/Tables/AnalyticsTable")

	local function personal(kind, flags)
		return Rules.PersonalMultiplier(kind, flags, EconomyTable)
	end

	describe("PersonalMultiplier", function()
		it("is 1 with nothing", function()
			expect(personal("Race", {})):equal(1)
		end)
		it("is 2 with the pass or the boost alone", function()
			expect(personal("Race", { CoinsPass = true })):equal(2)
			expect(personal("Race", { CoinsBoost = true })):equal(2)
		end)
		it("gives x3, not x4, with 2x pass and 2x boost", function()
			expect(personal("Race", { CoinsPass = true, CoinsBoost = true })):equal(3)
		end)
		it("ignores the boost and trick pass for rewards", function()
			expect(personal("Reward", { CoinsPass = true, CoinsBoost = true, TrickPass = true })):equal(2)
			expect(personal("Reward", { CoinsBoost = true })):equal(1)
		end)
		it("adds the trick pass for tricks up to x4", function()
			expect(personal("Trick", { CoinsPass = true, CoinsBoost = true, TrickPass = true })):equal(4)
			expect(personal("Trick", { TrickPass = true })):equal(2)
		end)
		it("does not let the trick pass touch race coins", function()
			expect(personal("Race", { CoinsPass = true, CoinsBoost = true, TrickPass = true })):equal(3)
		end)
		it("falls back to 1 for an unknown kind", function()
			expect(personal("Nope", { CoinsPass = true })):equal(1)
		end)
	end)

	describe("Payout", function()
		it("is tier base x round x personal, rounded down", function()
			expect(Rules.Payout(3, 1.5, 1, 1)):equal(4) -- 4.5
			expect(Rules.Payout(5, 1.2, 3, 1)):equal(18)
			expect(Rules.Payout(10, 3, 3, 1)):equal(90)
		end)
		it("has a minimum of 1", function()
			expect(Rules.Payout(2, 0.1, 1, 1)):equal(1)
		end)
		it("pays 0 for a base of 0 or less", function()
			expect(Rules.Payout(0, 3, 3, 1)):equal(0)
			expect(Rules.Payout(-5, 1, 1, 1)):equal(0)
			expect(Rules.Payout(nil, 1, 1, 1)):equal(0)
		end)
		it("does not lose a coin to float error", function()
			expect(Rules.Payout(100, 1.1, 3, 1)):equal(330)
		end)
		it("matches every tier at x1", function()
			for _, tier in CourseTable.Tiers do
				local base = tier.CheckpointCoins
				expect(Rules.Payout(base, 1, 1, 1)):equal(base > 0 and base or 0)
			end
		end)
	end)

	describe("CheckpointBase", function()
		local tier = CourseTable.Tiers.Medium
		it("pays the tier coins", function()
			expect(Rules.CheckpointBase(tier, false, false)):equal(tier.CheckpointCoins)
		end)
		it("pays nothing for a skipped checkpoint", function()
			expect(Rules.CheckpointBase(tier, true, false)):equal(0)
		end)
		it("pays nothing at the finish checkpoint or for a missing tier", function()
			expect(Rules.CheckpointBase(CourseTable.Tiers.Finale, false, true)):equal(0)
			expect(Rules.CheckpointBase(nil, false, false)):equal(0)
		end)
	end)

	describe("FinishBase", function()
		it("adds the place bonus for the top 3", function()
			expect(Rules.FinishBase(1, EconomyTable)):equal(150)
			expect(Rules.FinishBase(2, EconomyTable)):equal(130)
			expect(Rules.FinishBase(3, EconomyTable)):equal(120)
		end)
		it("pays the base for 4th and beyond", function()
			expect(Rules.FinishBase(4, EconomyTable)):equal(100)
			expect(Rules.FinishBase(nil, EconomyTable)):equal(100)
		end)
	end)

	describe("DuplicateCoins", function()
		it("pays the rarity value", function()
			expect(Rules.DuplicateCoins(BallTable.sprinter, "Coins", RarityTable, EconomyTable)):equal(75)
		end)
		it("pays the flat wheel value for the wheel exclusive", function()
			local wheelBall = { Source = "Wheel", Rarity = "Rare" }
			expect(Rules.DuplicateCoins(wheelBall, "Wheel", RarityTable, EconomyTable)):equal(2500)
		end)
		it("pays nothing for Limited or unknown balls", function()
			expect(
				Rules.DuplicateCoins({ Source = "RobuxLimited", Rarity = "Limited" }, "x", RarityTable, EconomyTable)
			):equal(0)
			expect(Rules.DuplicateCoins(nil, "x", RarityTable, EconomyTable)):equal(0)
		end)
	end)

	describe("TransactionType", function()
		it("maps sources to analytics transaction types", function()
			expect(Rules.TransactionType("Checkpoint", AnalyticsTable)):equal("Gameplay")
			expect(Rules.TransactionType("Shop", AnalyticsTable)):equal("Shop")
			expect(Rules.TransactionType("Daily", AnalyticsTable)):equal("TimedReward")
			expect(Rules.TransactionType("Admin", AnalyticsTable)):equal("Admin")
		end)
	end)

	describe("boost countdown", function()
		it("ticks down and drops expired boosts", function()
			local left, expired = Rules.TickBoosts({ coins2x = 10, other = 1 }, 2)
			expect(left):equal({ coins2x = 8 })
			expect(expired):equal({ "other" })
		end)
		it("never mutates its input", function()
			local input = { coins2x = 5 }
			Rules.TickBoosts(input, 1)
			expect(input):equal({ coins2x = 5 })
		end)
		it("adds time to the end of an existing boost", function()
			local left, added = Rules.AddBoost({ coins2x = 60 }, "coins2x", 600, 7200)
			expect(left.coins2x):equal(660)
			expect(added):equal(600)
		end)
		it("caps the bank", function()
			local left, added = Rules.AddBoost({ coins2x = 7000 }, "coins2x", 600, 7200)
			expect(left.coins2x):equal(7200)
			expect(added):equal(200)
			local full, none = Rules.AddBoost({ coins2x = 7200 }, "coins2x", 600, 7200)
			expect(full.coins2x):equal(7200)
			expect(none):equal(0)
		end)
		it("uses the table's 120 minute bank", function()
			expect(EconomyTable.Boost.Coins2xBankCapMinutes * 60):equal(7200)
		end)
	end)
end)
